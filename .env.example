NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
STORAGE_MODE=demo
PERSONAL_STORAGE_PATH=.ai/private
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=you@example.com
# Required when GOOGLE_CLIENT_ID and GOOGLE_ALLOWED_EMAILS are set. Generate with: openssl rand -base64 48
GOOGLE_SESSION_SECRET=
# Server-only key for Cloud Translation Basic (v2). Never expose it in the PWA.
GOOGLE_TRANSLATE_API_KEY=
# Server-only Cloudflare Workers AI credentials for online reader transcription.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MY_SHIFT_CLIENT_ID=
