{
  "name": "mentor-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI English learning platform monorepo.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mentor-ai/pwa",
    "dev:pwa": "npm run dev --workspace @mentor-ai/pwa",
    "dev:api": "npm run dev --workspace @mentor-ai/api",
    "build": "npm run build --workspaces",
    "build:vercel": "npm run build --workspace @mentor-ai/shared && npm run prepare:pwa-update-manifest && npm run build:pwa && npm run check:deployment-output",
    "build:pwa": "npm run build --workspace @mentor-ai/pwa && npm run optimize:pwa-assets",
    "build:api": "npm run build --workspace @mentor-ai/api",
    "prepare:pwa-update-manifest": "node scripts/write-pwa-update-manifest.mjs",
    "optimize:pwa-assets": "node scripts/optimize-pwa-assets.mjs",
    "check:deployment-output": "node scripts/check-deployment-output.mjs",
    "lint": "npm run lint --workspaces",
    "test": "npm run test:privacy && npm run test:lesson-queue && npm test --workspaces --if-present",
    "test:privacy": "node --test test/privacy-boundary.test.mjs",
    "test:lesson-queue": "node --test test/private-lesson-queue.test.mjs",
    "lessons:queue:status": "node scripts/private-lesson-queue.mjs status",
    "lessons:queue:sync": "node scripts/private-lesson-queue.mjs sync",
    "precommit": "npm run test:privacy",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "tsx": "4.21.0"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "edge-tts-universal": "^1.4.0"
  }
}
