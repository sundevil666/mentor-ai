{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "apps/pwa/dist/pwa",
  "installCommand": "npm install --ignore-scripts",
  "framework": null,
  "routes": [
    {
      "src": "^/api/health$",
      "dest": "/api/configuration?health=1"
    },
    {
      "src": "^/api/reader/(lookup|usage)$",
      "dest": "/api/reader?action=$1"
    },
    {
      "src": "^/api/reader/books-synchronize$",
      "dest": "/api/synchronization?action=books"
    },
    {
      "src": "^/app-update\\.json$",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/(?:index\\.html)?$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/assets/(.*)$",
      "status": 404
    },
    {
      "src": "^(?:/(.*))$",
      "dest": "/index.html"
    }
  ]
}
